{{!< layouts/main }}
<section class="card">
  <h1>Register</h1>
  {{#if errors}}
    <ul class="alert danger">{{#each errors}}<li>{{this}}</li>{{/each}}</ul>
  {{/if}}

  <form method="post" action="/register">
    <label>Username <input name="username" value="{{body.username}}" required></label>
    <label>Email <input type="email" name="email" value="{{body.email}}" required></label>
    <label>Password <input type="password" name="password" minlength="6" required></label>
    <label>Confirm Password <input type="password" name="confirm" minlength="6" required></label>
    <button type="submit">Create Account</button>
  </form>
</section>
